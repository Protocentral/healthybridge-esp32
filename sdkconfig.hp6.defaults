# HealthyPi 6 profile — UART host link (M7 UART4), HP6 payload profile.
# Layered on sdkconfig.defaults. Target (esp32c6) is set by hp6.sh via set-target.
#
# These are DEFAULTS: they seed sdkconfig.hp6 when it does not exist and are
# ignored once it does. After changing a line here, run `./hp6.sh clean` (or
# delete sdkconfig.hp6) or the old value stays in effect.
CONFIG_HB_PROFILE_HP6=y

# Host link baud. Bring up at 921600 (bit-identical to the released HealthyPi 5
# link, so a failure is unambiguously an HP6 problem), then raise both ends to
# 2000000 once the link is clean.
CONFIG_HB_UART_BAUD_HP6=2000000

# Wi-Fi TX power ceiling, in dBm.
#
# 20 dBm (100 mW) is the IDF maximum and was in force purely by default -- it was
# never a decision. Peak TX current is the single largest term in the HealthyPi 6
# power budget, and the BQ24074's input ceiling is strapped in hardware, so a
# USB-powered unit has no headroom to spend on transmit power it does not need.
# 13 dBm (20 mW) is a quarter of the range at a fifth of the peak draw, and the
# co-processor is normally within a few metres of the phone or AP it is talking
# to. Raise it if a deployment genuinely needs the range, and re-measure the
# brownout margin when you do.
CONFIG_ESP_PHY_MAX_WIFI_TX_POWER=13
